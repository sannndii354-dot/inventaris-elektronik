# Salin file ini menjadi .env lalu isi nilainya.
# Port di server yang akan dipakai (http://IP-SERVER:PORT)
PORT=3000

# Login untuk membuka aplikasi. WAJIB diisi jika server bisa diakses dari internet.
APP_USER=admin
APP_PASSWORD=

# Auto backup ke Google Drive (opsional). Cara mengisi: lihat README bagian "Auto backup ke Google Drive".
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Nama folder di Google Drive (dibuat otomatis oleh aplikasi).
GDRIVE_FOLDER_NAME="Inventaris Elektronik Backup"
# Jarak antar backup (jam) dan jumlah file backup yang disimpan.
GDRIVE_BACKUP_HOURS=24
GDRIVE_KEEP=30
